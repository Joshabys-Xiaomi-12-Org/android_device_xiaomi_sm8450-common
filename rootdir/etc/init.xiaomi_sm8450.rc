import /vendor/etc/init/hw/init.mi_thermald.rc
import /vendor/etc/init/hw/init.batterysecret.rc

on fs
    mkdir /mnt/vendor/persist/haptics 0755 system system
    mkdir /mnt/vendor/persist/audio 0755 system system
    mkdir /mnt/vendor/persist/qca6490/ 0700 system system

on boot
    # modem
    chmod 0777 /dev/smd8
    chown radio radio /dev/smd8
    mkdir /data/vendor/modem 0777 radio radio

    chown system system /sys/class/thermal/thermal_message/sconfig
    chown system system /sys/class/thermal/thermal_message/charger_temp
    chown system system /sys/class/thermal/thermal_message/board_sensor_temp_comp
    chown system system /sys/class/thermal/thermal_message/cpu_nolimit_temp
    chown system system /sys/class/thermal/thermal_message/balance_mode
    chown cameraserver cameraserver /sys/class/thermal/thermal_message/flash_state
    chown system system /sys/module/perf_helper/mimd/mimdtrigger

    # Workarround for cache
     rm /data/resource-cache
     rm /data/system/package_cache

    # Create persist for camera calibration data
    mkdir /mnt/vendor/persist/camera 0755 system cameraserver

    # Set fingerprint related permissions
    chmod 0660 /dev/goodix_fp
    chown system system /dev/goodix_fp
    chown system system /sys/bus/platform/devices/soc:fingerprint_fpc/irq
    chown system system /sys/bus/platform/devices/soc:fingerprint_fpc/irq_enable
    chown system system /sys/bus/platform/devices/soc:fingerprint_fpc/wakeup_enable
    chown system system /sys/bus/platform/devices/soc:fingerprint_fpc/hw_reset
    chown system system /sys/bus/platform/devices/soc:fingerprint_fpc/device_prepare
    chown system system /sys/bus/platform/devices/soc:fingerprint_fpc/fingerdown_wait
    chown system system /sys/bus/platform/devices/soc:fingerprint_fpc/vendor
    chown system system /sys/bus/platform/devices/soc:fingerprint_fpc/request_vreg
    chown system system /sys/bus/platform/devices/soc:fingerprint_fpc/simulate_irq
    chown system system /sys/bus/platform/devices/soc:fingerprint_fpc/finger_irq
    chown system system /sys/bus/platform/devices/soc:fingerprint_fpc/power_cfg

    # Xiaomi touch
    chown system system /dev/xiaomi-touch
    chmod 0660 /dev/xiaomi-touch

    # Touchscreen sensors
    chown system system /sys/class/touch/touch_dev/fod_finger_state
    chown system system /sys/class/touch/touch_dev/fod_longpress_gesture_enabled
    chown system system /sys/class/touch/touch_dev/fod_press_status
    chmod 0660 /sys/class/touch/touch_dev/fod_finger_state
    chmod 0660 /sys/class/touch/touch_dev/fod_longpress_gesture_enabled
    chmod 0660 /sys/class/touch/touch_dev/fod_press_status

    chown system system /sys/class/touch/touch_dev/gesture_single_tap_enabled
    chown system system /sys/class/touch/touch_dev/gesture_single_tap_state
    chmod 0660 /sys/class/touch/touch_dev/gesture_single_tap_enabled
    chmod 0660 /sys/class/touch/touch_dev/gesture_single_tap_state

    chown system system /sys/class/touch/touch_dev/gesture_double_tap_enabled
    chown system system /sys/class/touch/touch_dev/gesture_double_tap_state
    chmod 0660 /sys/class/touch/touch_dev/gesture_double_tap_enabled
    chmod 0660 /sys/class/touch/touch_dev/gesture_double_tap_state

    # High touch polling rate
    chown system system /sys/devices/virtual/touch/touch_dev/bump_sample_rate
    chmod 0660 /sys/devices/virtual/touch/touch_dev/bump_sample_rate

    # GPU 
    chown system system /sys/class/kgsl/kgsl-3d0/devfreq/max_freq
    chown system system /sys/class/kgsl/kgsl-3d0/devfreq/max_clock_mhz
    chown system system /sys/class/kgsl/kgsl-3d0/devfreq/min_freq
    chown system system /sys/class/kgsl/kgsl-3d0/devfreq/min_clock_mhz
 
    chmod 0664 /sys/class/kgsl/kgsl-3d0/devfreq/max_freq
    chmod 0664 /sys/class/kgsl/kgsl-3d0/devfreq/max_clock_mhz
    chmod 0664 /sys/class/kgsl/kgsl-3d0/devfreq/min_freq
    chmod 0664 /sys/class/kgsl/kgsl-3d0/devfreq/min_clock_mhz
 
    # CPU Little Cluster (Policy 0)
    chown system system /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy0/scaling_governor
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy0/scaling_governor
 
    # CPU Big Cluster (Policy 3)
    chown system system /sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy4/scaling_max_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy4/scaling_governor
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy4/scaling_max_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy4/scaling_governor
 
    # CPU Prime Cluster (Policy 7)
    chown system system /sys/devices/system/cpu/cpufreq/policy7/scaling_min_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy7/scaling_max_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy7/scaling_governor
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy7/scaling_min_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy7/scaling_max_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy7/scaling_governor

on post-fs-data
    # Create folder of camera
    mkdir /data/vendor/camera/offlinelog 0777 cameraserver audio
    chmod 0666 /dev/camlog

    # Create the directories used by the Wireless subsystem
    mkdir /data/vendor/mac_addr 0770 system wifi

    mkdir /data/vendor/thermal 0771 root system
    mkdir /data/vendor/thermal/config 0771 root system
    mkdir /data/vendor/perfspy 0775 camera camera
    chmod 0660 /dev/ir_spi
    chown system system /dev/ir_spi

    # Local HBM
    chown system system /sys/devices/platform/soc/soc:qcom,dsi-display-primary/local_hbm

    # Create fingerprint related directories
    mkdir /data/vendor/fpc 0770 system system
    mkdir /data/vendor/fpdump 0770 system system
    mkdir /data/vendor/goodix 0770 system system
    mkdir /mnt/vendor/persist/fpc 0770 system system
    mkdir /mnt/vendor/persist/goodix 0770 system system

on property:sys.boot_completed=1
    # Set thermal mode to mgame
    write /sys/devices/virtual/thermal/thermal_message/sconfig 20

    # Setup dex2oat thread count and cpuset
    setprop dalvik.vm.dex2oat-cpu-set 0,1,2,3,4,5,6
    setprop dalvik.vm.dex2oat-threads 6

    setprop dalvik.vm.image-dex2oat-cpu-set 0,1,2,3,4,5,6
    setprop dalvik.vm.image-dex2oat-threads 6

    # Configure uclamp
    write /proc/sys/kernel/sched_util_clamp_min_rt_default 128

    write /dev/cpuctl/top-app/cpu.uclamp.min 15
    write /dev/cpuctl/background/cpu.uclamp.max 80
    write /dev/cpuctl/system-background/cpu.uclamp.max 40
    write /dev/cpuctl/nnapi-hal/cpu.uclamp.min 2
    write /dev/cpuctl/nnapi-hal/cpu.uclamp.latency_sensitive 0

    # Allow camera HAL to boost camera-daemon CPU shares
    chown cameraserver camera /dev/cpuctl/camera-daemon/cpu.shares
    chmod 0664 /dev/cpuctl/camera-daemon/cpu.shares

    # Dynamically set IRQ affinity for KGSL and DRM
    exec u:r:vendor_qti_init_shell:s0 -- /vendor/bin/init.xiaomi_sm8450.sh

    # Enable suspend to RAM
    write /sys/power/mem_sleep "deep"

on property:persist.sys.device_provisioned=1 && property:sys.boot_completed=1
    # Cap dex2oat cpu utilization
    write /dev/cpuctl/dex2oat/cpu.uclamp.max 60

on property:vendor.post_boot.parsed=1
    # Set restricted cpuset to the same CPUs as system-background
    copy /dev/cpuset/system-background/cpus /dev/cpuset/restricted/cpus
    # Set power profile mode on boot
    # setprop sys.perf_mode_active 1

on property:persist.sys.xtra-daemon.enabled=*
    restart loc_launcher

on property:persist.sys.aux_camera_control=*
    setprop vendor.camera.aux.packageexcludelist ${persist.sys.aux_camera_control}

service vendor.nv_mac /vendor/bin/nv_mac
    class late_start
    user system
    group system inet net_admin wifi net_raw
    oneshot

service vendor.audio-hal /vendor/bin/hw/android.hardware.audio.service
    override
    class hal
    user audioserver
    # media gid needed for /dev/fm (radio) and for /data/misc/media (tee)
    group audio camera drmrpc inet media mediadrm net_bt net_bt_admin net_bw_acct oem_2901 wakelock context_hub system
    capabilities BLOCK_SUSPEND SYS_NICE
    # setting RLIMIT_RTPRIO allows binder RT priority inheritance
    rlimit rtprio 10 10
    ioprio rt 4
    task_profiles ProcessCapacityHigh HighPerformance
    onrestart restart audioserver
    socket audio_us_socket_0 seqpacket 0666 system system

service vendor.sensors-hal-multihal /vendor/bin/hw/android.hardware.sensors-service.xiaomi-multihal
    override
    class hal
    user system
    group system wakelock context_hub input uhid
    task_profiles ServiceCapacityLow
    capabilities BLOCK_SUSPEND
    rlimit rtprio 10 10
    socket audio_us_socket_1 seqpacket 0666 system system

on property:ro.boot.hwversion=*
    setprop ro.boot.hardware.revision ${ro.boot.hwc}_${ro.boot.hwlevel}_${ro.boot.hwversion}

# Enable WLAN SSR recovery
on property:persist.vendor.ssr.restart_level=ALL_ENABLE
    write /sys/kernel/cnss/recovery 1

# Disable WLAN SSR recovery
on property:persist.vendor.ssr.restart_level=ALL_DISABLE
    write /sys/kernel/cnss/recovery 0

# Gaming Mode: sys.perf_mode_active=3
on property:sys.perf_mode_active=3
    write /sys/devices/system/cpu/qcom_lpm/parameters/sleep_disabled 1

    write /sys/class/thermal/thermal_message/sconfig 13

    write /sys/devices/system/cpu/cpufreq/policy0/walt/down_rate_limit_us 0
    write /sys/devices/system/cpu/cpufreq/policy0/walt/up_rate_limit_us 0
    write /sys/devices/system/cpu/cpufreq/policy4/walt/down_rate_limit_us 0
    write /sys/devices/system/cpu/cpufreq/policy4/walt/up_rate_limit_us 0
    write /sys/devices/system/cpu/cpufreq/policy7/walt/down_rate_limit_us 0
    write /sys/devices/system/cpu/cpufreq/policy7/walt/up_rate_limit_us 0

# Performance Mode: sys.perf_mode_active=2
on property:sys.perf_mode_active=2
    write /sys/devices/system/cpu/qcom_lpm/parameters/sleep_disabled 1

    write /sys/class/thermal/thermal_message/sconfig 20

    write /sys/devices/system/cpu/cpufreq/policy0/walt/down_rate_limit_us 20000
    write /sys/devices/system/cpu/cpufreq/policy0/walt/up_rate_limit_us 500
    write /sys/devices/system/cpu/cpufreq/policy4/walt/down_rate_limit_us 10000
    write /sys/devices/system/cpu/cpufreq/policy4/walt/up_rate_limit_us 500
    write /sys/devices/system/cpu/cpufreq/policy7/walt/down_rate_limit_us 5000
    write /sys/devices/system/cpu/cpufreq/policy7/walt/up_rate_limit_us 500

# Balance Mode: sys.perf_mode_active=1
on property:sys.perf_mode_active=1
    write /sys/devices/system/cpu/qcom_lpm/parameters/sleep_disabled 0

    write /sys/class/thermal/thermal_message/sconfig 0

    write /sys/devices/system/cpu/cpufreq/policy0/walt/down_rate_limit_us 5000
    write /sys/devices/system/cpu/cpufreq/policy0/walt/up_rate_limit_us 500
    write /sys/devices/system/cpu/cpufreq/policy4/walt/down_rate_limit_us 2500
    write /sys/devices/system/cpu/cpufreq/policy4/walt/up_rate_limit_us 500
    write /sys/devices/system/cpu/cpufreq/policy7/walt/down_rate_limit_us 1000
    write /sys/devices/system/cpu/cpufreq/policy7/walt/up_rate_limit_us 500

# Battery Saver/Powersave Mode: sys.perf_mode_active=0
on property:sys.perf_mode_active=0
    write /sys/devices/system/cpu/qcom_lpm/parameters/sleep_disabled 0

    write /sys/class/thermal/thermal_message/sconfig 0

    write /sys/devices/system/cpu/cpufreq/policy0/walt/down_rate_limit_us 40000
    write /sys/devices/system/cpu/cpufreq/policy0/walt/up_rate_limit_us 20000
    write /sys/devices/system/cpu/cpufreq/policy4/walt/down_rate_limit_us 30000
    write /sys/devices/system/cpu/cpufreq/policy4/walt/up_rate_limit_us 20000
    write /sys/devices/system/cpu/cpufreq/policy7/walt/down_rate_limit_us 20000
    write /sys/devices/system/cpu/cpufreq/policy7/walt/up_rate_limit_us 10000

# GPU Settings (non-persistent; reapplied on boot only when apply_on_boot is enabled)
on property:sys.parts.gpu.min_frequency=*
    write /sys/class/kgsl/kgsl-3d0/devfreq/min_freq ${sys.parts.gpu.min_frequency}
    write /sys/class/kgsl/kgsl-3d0/min_clock_mhz ${sys.parts.gpu.min_clock}

on property:sys.parts.gpu.max_frequency=*
    write /sys/class/kgsl/kgsl-3d0/devfreq/max_freq ${sys.parts.gpu.max_frequency}
    write /sys/class/kgsl/kgsl-3d0/max_clock_mhz ${sys.parts.gpu.max_clock}

on property:sys.parts.gpu.governor=*
    write /sys/class/kgsl/kgsl-3d0/devfreq/governor ${sys.parts.gpu.governor}

on property:sys.parts.gpu.adreno_idler=*
    write /sys/module/msm_kgsl/parameters/adreno_idler_active ${sys.parts.gpu.adreno_idler}
    write /sys/module/adreno_idler/parameters/adreno_idler_active ${sys.parts.gpu.adreno_idler}

on property:sys.parts.gpu.idle_timer=*
    write /sys/class/kgsl/kgsl-3d0/idle_timer ${sys.parts.gpu.idle_timer}

# CPU Little Cluster (policy0)
on property:sys.parts.cpu.little.min_frequency=*
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq ${sys.parts.cpu.little.min_frequency}
on property:sys.parts.cpu.little.max_frequency=*
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq ${sys.parts.cpu.little.max_frequency}
on property:sys.parts.cpu.little.governor=*
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_governor ${sys.parts.cpu.little.governor}

# CPU Big Cluster (policy4)
on property:sys.parts.cpu.big.min_frequency=*
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq ${sys.parts.cpu.big.min_frequency}
on property:sys.parts.cpu.big.max_frequency=*
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_max_freq ${sys.parts.cpu.big.max_frequency}
on property:sys.parts.cpu.big.governor=*
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_governor ${sys.parts.cpu.big.governor}

# CPU Prime Cluster (policy7)
on property:sys.parts.cpu.prime.min_frequency=*
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_min_freq ${sys.parts.cpu.prime.min_frequency}
on property:sys.parts.cpu.prime.max_frequency=*
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_max_freq ${sys.parts.cpu.prime.max_frequency}
on property:sys.parts.cpu.prime.governor=*
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_governor ${sys.parts.cpu.prime.governor}

# CPU Input Boost
on property:sys.parts.cpu.input_boost=off
    write /proc/sys/walt/input_boost/input_boost_ms 0
    write /proc/sys/walt/input_boost/input_boost_freq "0 0 0 0 0 0 0 0"

on property:sys.parts.cpu.input_boost=low
    write /proc/sys/walt/input_boost/input_boost_ms 60
    write /proc/sys/walt/input_boost/input_boost_freq "1075200 0 0 0 0 0 0 0"

on property:sys.parts.cpu.input_boost=default
    write /proc/sys/walt/input_boost/input_boost_ms 120
    write /proc/sys/walt/input_boost/input_boost_freq "1324800 0 0 0 0 0 0 0"

on property:sys.parts.cpu.input_boost=high
    write /proc/sys/walt/input_boost/input_boost_ms 160
    write /proc/sys/walt/input_boost/input_boost_freq "1516800 0 0 0 1555200 0 0 0"

# WALT Governor Profile
on property:sys.parts.cpu.walt_profile=battery
    write /sys/devices/system/cpu/cpufreq/policy0/walt/up_rate_limit_us 2000
    write /sys/devices/system/cpu/cpufreq/policy0/walt/down_rate_limit_us 0
    write /sys/devices/system/cpu/cpufreq/policy4/walt/up_rate_limit_us 5000
    write /sys/devices/system/cpu/cpufreq/policy4/walt/down_rate_limit_us 0
    write /sys/devices/system/cpu/cpufreq/policy7/walt/up_rate_limit_us 10000
    write /sys/devices/system/cpu/cpufreq/policy7/walt/down_rate_limit_us 0

on property:sys.parts.cpu.walt_profile=default
    write /sys/devices/system/cpu/cpufreq/policy0/walt/up_rate_limit_us 500
    write /sys/devices/system/cpu/cpufreq/policy0/walt/down_rate_limit_us 0
    write /sys/devices/system/cpu/cpufreq/policy4/walt/up_rate_limit_us 1000
    write /sys/devices/system/cpu/cpufreq/policy4/walt/down_rate_limit_us 0
    write /sys/devices/system/cpu/cpufreq/policy7/walt/up_rate_limit_us 2000
    write /sys/devices/system/cpu/cpufreq/policy7/walt/down_rate_limit_us 0

on property:sys.parts.cpu.walt_profile=responsive
    write /sys/devices/system/cpu/cpufreq/policy0/walt/up_rate_limit_us 0
    write /sys/devices/system/cpu/cpufreq/policy0/walt/down_rate_limit_us 10000
    write /sys/devices/system/cpu/cpufreq/policy4/walt/up_rate_limit_us 500
    write /sys/devices/system/cpu/cpufreq/policy4/walt/down_rate_limit_us 10000
    write /sys/devices/system/cpu/cpufreq/policy7/walt/up_rate_limit_us 500
    write /sys/devices/system/cpu/cpufreq/policy7/walt/down_rate_limit_us 5000

# Top-App Uclamp Profile
on property:sys.parts.cpu.uclamp=battery
    write /dev/cpuctl/top-app/cpu.uclamp.min 0
    write /dev/cpuctl/top-app/cpu.uclamp.max 70

on property:sys.parts.cpu.uclamp=default
    write /dev/cpuctl/top-app/cpu.uclamp.min 0
    write /dev/cpuctl/top-app/cpu.uclamp.max max

on property:sys.parts.cpu.uclamp=performance
    write /dev/cpuctl/top-app/cpu.uclamp.min 20
    write /dev/cpuctl/top-app/cpu.uclamp.max max

# Xiaomi Thermal Editor (apply/reset encrypted overrides in /data/vendor/thermal/config)
on property:sys.parts.thermal.action=apply
    copy /data/user_de/0/org.lineageos.settings/files/thermal_staging/${sys.parts.thermal.file} /data/vendor/thermal/config/${sys.parts.thermal.file}
    chown root system /data/vendor/thermal/config/${sys.parts.thermal.file}
    chmod 0664 /data/vendor/thermal/config/${sys.parts.thermal.file}
    restart mi_thermald
    setprop sys.parts.thermal.action idle

on property:sys.parts.thermal.action=reset
    rm /data/vendor/thermal/config/${sys.parts.thermal.file}
    restart mi_thermald
    setprop sys.parts.thermal.action idle

# Disable/Enable mi_thermald (non-persistent; automatically restored on reboot)
on property:sys.parts.thermal.disabled=1
    stop mi_thermald

on property:sys.parts.thermal.disabled=0
    start mi_thermald

# Powertools ZRAM & VM Tuning
service vendor.parts-zram /vendor/bin/init.parts.zram.sh
    class main
    user root
    group root system
    disabled
    oneshot

on property:sys.parts.zram.action=apply
    start vendor.parts-zram
    setprop sys.parts.zram.action idle

on property:sys.parts.vm.swappiness=*
    write /proc/sys/vm/swappiness ${sys.parts.vm.swappiness}

on property:sys.parts.vm.vfs_cache_pressure=*
    write /proc/sys/vm/vfs_cache_pressure ${sys.parts.vm.vfs_cache_pressure}

on property:sys.parts.vm.page_cluster=*
    write /proc/sys/vm/page-cluster ${sys.parts.vm.page_cluster}

on property:sys.parts.vm.dirty_ratio=*
    write /proc/sys/vm/dirty_ratio ${sys.parts.vm.dirty_ratio}

on property:sys.parts.vm.dirty_background_ratio=*
    write /proc/sys/vm/dirty_background_ratio ${sys.parts.vm.dirty_background_ratio}

# Powertools I/O & Network Tuning
on property:sys.parts.io.scheduler=*
    write /sys/block/sda/queue/scheduler ${sys.parts.io.scheduler}
    write /sys/block/sdb/queue/scheduler ${sys.parts.io.scheduler}
    write /sys/block/sdc/queue/scheduler ${sys.parts.io.scheduler}
    write /sys/block/sde/queue/scheduler ${sys.parts.io.scheduler}
    write /sys/block/sdf/queue/scheduler ${sys.parts.io.scheduler}

on property:sys.parts.io.read_ahead_kb=*
    write /sys/block/sda/queue/read_ahead_kb ${sys.parts.io.read_ahead_kb}
    write /sys/block/sdb/queue/read_ahead_kb ${sys.parts.io.read_ahead_kb}
    write /sys/block/sdc/queue/read_ahead_kb ${sys.parts.io.read_ahead_kb}
    write /sys/block/sde/queue/read_ahead_kb ${sys.parts.io.read_ahead_kb}
    write /sys/block/sdf/queue/read_ahead_kb ${sys.parts.io.read_ahead_kb}

on property:sys.parts.net.tcp_congestion=*
    write /proc/sys/net/ipv4/tcp_congestion_control ${sys.parts.net.tcp_congestion}
