<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- GPU Optimizer Section -->
    <PreferenceCategory
        android:key="gpu_category"
        android:title="@string/powertools_gpu_category">

        <SwitchPreferenceCompat
            android:key="gpu_enable"
            android:title="@string/powertools_gpu_enable_title"
            android:summary="@string/powertools_gpu_enable_summary"
            android:defaultValue="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="gpu_freq_category"
        android:title="@string/powertools_gpu_freq_category">

        <ListPreference
            android:key="gpu_min_frequency"
            android:title="@string/gpu_min_frequency"
            android:summary="%s" />

        <ListPreference
            android:key="gpu_max_frequency"
            android:title="@string/gpu_max_frequency"
            android:summary="%s" />

    </PreferenceCategory>

    <!-- CPU Optimizer Section -->
    <PreferenceCategory
        android:key="cpu_category"
        android:title="@string/powertools_cpu_category">

        <SwitchPreferenceCompat
            android:key="cpu_enable"
            android:title="@string/powertools_cpu_enable_title"
            android:summary="@string/powertools_cpu_enable_summary"
            android:defaultValue="false" />

    </PreferenceCategory>

    <!-- CPU Little Cluster -->
    <PreferenceCategory
        android:key="cpu_little_category"
        android:title="@string/powertools_cpu_little_category">

        <ListPreference
            android:key="cpu_little_min_frequency"
            android:title="@string/powertools_cpu_min_freq"
            android:summary="%s" />

        <ListPreference
            android:key="cpu_little_max_frequency"
            android:title="@string/powertools_cpu_max_freq"
            android:summary="%s" />

        <ListPreference
            android:key="cpu_little_governor"
            android:title="@string/powertools_cpu_governor"
            android:summary="%s" />

    </PreferenceCategory>

    <!-- CPU Big Cluster -->
    <PreferenceCategory
        android:key="cpu_big_category"
        android:title="@string/powertools_cpu_big_category">

        <ListPreference
            android:key="cpu_big_min_frequency"
            android:title="@string/powertools_cpu_min_freq"
            android:summary="%s" />

        <ListPreference
            android:key="cpu_big_max_frequency"
            android:title="@string/powertools_cpu_max_freq"
            android:summary="%s" />

        <ListPreference
            android:key="cpu_big_governor"
            android:title="@string/powertools_cpu_governor"
            android:summary="%s" />

    </PreferenceCategory>

    <!-- CPU Prime Cluster -->
    <PreferenceCategory
        android:key="cpu_prime_category"
        android:title="@string/powertools_cpu_prime_category">

        <ListPreference
            android:key="cpu_prime_min_frequency"
            android:title="@string/powertools_cpu_min_freq"
            android:summary="%s" />

        <ListPreference
            android:key="cpu_prime_max_frequency"
            android:title="@string/powertools_cpu_max_freq"
            android:summary="%s" />

        <ListPreference
            android:key="cpu_prime_governor"
            android:title="@string/powertools_cpu_governor"
            android:summary="%s" />

    </PreferenceCategory>

</PreferenceScreen>
