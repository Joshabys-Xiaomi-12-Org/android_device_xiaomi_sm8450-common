<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Live Monitor Section -->
    <PreferenceCategory
        android:key="live_monitor_category"
        android:title="@string/powertools_live_monitor_category">

        <Preference
            android:key="live_cpu_clocks"
            android:title="@string/powertools_live_cpu_title"
            android:summary="@string/powertools_live_reading"
            android:selectable="false" />

        <Preference
            android:key="live_gpu_temp"
            android:title="@string/powertools_live_gpu_temp_title"
            android:summary="@string/powertools_live_reading"
            android:selectable="false" />

    </PreferenceCategory>

    <!-- General Section -->
    <PreferenceCategory
        android:key="general_category"
        android:title="@string/powertools_general_category">

        <ListPreference
            android:key="power_preset"
            android:title="@string/powertools_preset_title"
            android:entries="@array/powertools_preset_entries"
            android:entryValues="@array/powertools_preset_values"
            android:defaultValue="default"
            android:summary="%s" />

        <SwitchPreferenceCompat
            android:key="apply_on_boot"
            android:title="@string/powertools_apply_on_boot_title"
            android:summary="@string/powertools_apply_on_boot_summary"
            android:defaultValue="false" />

        <SwitchPreferenceCompat
            android:key="thermal_auto_profiles"
            android:title="@string/powertools_auto_thermal_title"
            android:summary="@string/powertools_auto_thermal_summary"
            android:defaultValue="false" />

        <Preference
            android:key="reset_defaults"
            android:title="@string/powertools_reset_title"
            android:summary="@string/powertools_reset_summary" />

    </PreferenceCategory>

    <!-- GPU Optimizer Section -->
    <PreferenceCategory
        android:key="gpu_category"
        android:title="@string/powertools_gpu_category">

        <SwitchPreferenceCompat
            android:key="gpu_enable"
            android:title="@string/powertools_gpu_enable_title"
            android:summary="@string/powertools_gpu_enable_summary"
            android:defaultValue="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="gpu_freq_category"
        android:title="@string/powertools_gpu_freq_category">

        <ListPreference
            android:key="gpu_min_frequency"
            android:title="@string/gpu_min_frequency"
            android:summary="%s" />

        <ListPreference
            android:key="gpu_max_frequency"
            android:title="@string/gpu_max_frequency"
            android:summary="%s" />

        <ListPreference
            android:key="gpu_governor"
            android:title="@string/powertools_gpu_governor"
            android:summary="%s" />

        <SwitchPreferenceCompat
            android:key="gpu_adreno_idler"
            android:title="@string/powertools_adreno_idler_title"
            android:summary="@string/powertools_adreno_idler_summary"
            android:defaultValue="true" />

        <ListPreference
            android:key="gpu_idle_timer"
            android:title="@string/powertools_gpu_idle_timer"
            android:entries="@array/powertools_gpu_idle_timer_entries"
            android:entryValues="@array/powertools_gpu_idle_timer_values"
            android:defaultValue="40"
            android:summary="%s" />

    </PreferenceCategory>

    <!-- CPU Optimizer Section -->
    <PreferenceCategory
        android:key="cpu_category"
        android:title="@string/powertools_cpu_category">

        <SwitchPreferenceCompat
            android:key="cpu_enable"
            android:title="@string/powertools_cpu_enable_title"
            android:summary="@string/powertools_cpu_enable_summary"
            android:defaultValue="false" />

    </PreferenceCategory>

    <!-- CPU Tuning -->
    <PreferenceCategory
        android:key="cpu_tuning_category"
        android:title="@string/powertools_cpu_tuning_category">

        <ListPreference
            android:key="cpu_input_boost"
            android:title="@string/powertools_input_boost_title"
            android:entries="@array/powertools_input_boost_entries"
            android:entryValues="@array/powertools_input_boost_values"
            android:defaultValue="default"
            android:summary="%s" />

        <ListPreference
            android:key="cpu_walt_profile"
            android:title="@string/powertools_walt_profile_title"
            android:entries="@array/powertools_walt_profile_entries"
            android:entryValues="@array/powertools_walt_profile_values"
            android:defaultValue="default"
            android:summary="%s" />

        <SwitchPreferenceCompat
            android:key="cpu_limit_prime"
            android:title="@string/powertools_limit_prime_title"
            android:summary="@string/powertools_limit_prime_summary"
            android:defaultValue="false" />

        <ListPreference
            android:key="cpu_uclamp_profile"
            android:title="@string/powertools_uclamp_title"
            android:entries="@array/powertools_uclamp_entries"
            android:entryValues="@array/powertools_uclamp_values"
            android:defaultValue="default"
            android:summary="%s" />

    </PreferenceCategory>

    <!-- CPU Little Cluster -->
    <PreferenceCategory
        android:key="cpu_little_category"
        android:title="@string/powertools_cpu_little_category">

        <ListPreference
            android:key="cpu_little_min_frequency"
            android:title="@string/powertools_cpu_min_freq"
            android:summary="%s" />

        <ListPreference
            android:key="cpu_little_max_frequency"
            android:title="@string/powertools_cpu_max_freq"
            android:summary="%s" />

        <ListPreference
            android:key="cpu_little_governor"
            android:title="@string/powertools_cpu_governor"
            android:summary="%s" />

    </PreferenceCategory>

    <!-- CPU Big Cluster -->
    <PreferenceCategory
        android:key="cpu_big_category"
        android:title="@string/powertools_cpu_big_category">

        <ListPreference
            android:key="cpu_big_min_frequency"
            android:title="@string/powertools_cpu_min_freq"
            android:summary="%s" />

        <ListPreference
            android:key="cpu_big_max_frequency"
            android:title="@string/powertools_cpu_max_freq"
            android:summary="%s" />

        <ListPreference
            android:key="cpu_big_governor"
            android:title="@string/powertools_cpu_governor"
            android:summary="%s" />

    </PreferenceCategory>

    <!-- CPU Prime Cluster -->
    <PreferenceCategory
        android:key="cpu_prime_category"
        android:title="@string/powertools_cpu_prime_category">

        <ListPreference
            android:key="cpu_prime_min_frequency"
            android:title="@string/powertools_cpu_min_freq"
            android:summary="%s" />

        <ListPreference
            android:key="cpu_prime_max_frequency"
            android:title="@string/powertools_cpu_max_freq"
            android:summary="%s" />

        <ListPreference
            android:key="cpu_prime_governor"
            android:title="@string/powertools_cpu_governor"
            android:summary="%s" />

    </PreferenceCategory>

    <!-- ZRAM & Memory Optimizer Section -->
    <PreferenceCategory
        android:key="zram_category"
        android:title="@string/powertools_zram_category">

        <SwitchPreferenceCompat
            android:key="zram_enable"
            android:title="@string/powertools_zram_enable_title"
            android:summary="@string/powertools_zram_enable_summary"
            android:defaultValue="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="zram_config_category"
        android:title="@string/powertools_zram_config_category">

        <ListPreference
            android:key="zram_size"
            android:title="@string/powertools_zram_size_title"
            android:entries="@array/powertools_zram_size_entries"
            android:entryValues="@array/powertools_zram_size_values"
            android:summary="%s" />

        <ListPreference
            android:key="zram_algorithm"
            android:title="@string/powertools_zram_algo_title"
            android:summary="%s" />

        <ListPreference
            android:key="vm_swappiness"
            android:title="@string/powertools_vm_swappiness_title"
            android:entries="@array/powertools_vm_swappiness_entries"
            android:entryValues="@array/powertools_vm_swappiness_entries"
            android:summary="%s" />

        <ListPreference
            android:key="vm_vfs_cache_pressure"
            android:title="@string/powertools_vm_vfs_pressure_title"
            android:entries="@array/powertools_vm_vfs_pressure_entries"
            android:entryValues="@array/powertools_vm_vfs_pressure_entries"
            android:summary="%s" />

        <ListPreference
            android:key="vm_page_cluster"
            android:title="@string/powertools_vm_page_cluster_title"
            android:entries="@array/powertools_vm_page_cluster_entries"
            android:entryValues="@array/powertools_vm_page_cluster_values"
            android:summary="%s" />

        <ListPreference
            android:key="vm_dirty_profile"
            android:title="@string/powertools_vm_dirty_profile_title"
            android:entries="@array/powertools_vm_dirty_profile_entries"
            android:entryValues="@array/powertools_vm_dirty_profile_values"
            android:summary="%s" />

    </PreferenceCategory>

</PreferenceScreen>
