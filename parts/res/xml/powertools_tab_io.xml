<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Storage I/O Optimizer Section -->
    <PreferenceCategory
        android:key="io_category"
        android:title="@string/powertools_io_category">

        <SwitchPreferenceCompat
            android:key="io_enable"
            android:title="@string/powertools_io_enable_title"
            android:summary="@string/powertools_io_enable_summary"
            android:defaultValue="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="io_config_category"
        android:title="@string/powertools_io_config_category">

        <ListPreference
            android:key="io_scheduler"
            android:title="@string/powertools_io_scheduler_title"
            android:summary="%s" />

        <ListPreference
            android:key="io_read_ahead"
            android:title="@string/powertools_io_read_ahead_title"
            android:entries="@array/powertools_io_read_ahead_entries"
            android:entryValues="@array/powertools_io_read_ahead_values"
            android:summary="%s" />

    </PreferenceCategory>

    <com.android.settingslib.widget.FooterPreference
        android:key="help_io"
        android:title="@string/powertools_help_io"
        android:selectable="false" />

</PreferenceScreen>
